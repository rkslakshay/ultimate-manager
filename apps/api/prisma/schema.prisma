// Ultimate Manager - database schema
// Phase 0: users, sessions and save games. Game-world tables arrive in Phase 1.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  displayName  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sessions     Session[]
  saves        SaveGame[]
}

/// Server-side record of an issued JWT so sessions can be revoked (logout, password change).
model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

model SaveGame {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  managerName   String
  /// World seed: the whole world is generated and simulated deterministically from it.
  seed          String
  /// Current in-game date.
  gameDate      DateTime @db.Date
  /// Denormalised display name of the managed club (null until a club is chosen).
  clubName      String?
  /// Club the user manages (null until chosen).
  managerClubId Int?
  /// WorldState schema version of the generated world (null = no world generated yet).
  worldVersion  Int?
  /// Data pack the world came from: "fictional" (generated) or an imported pack id ("real", "sample").
  dataPack      String   @default("fictional")
  /// Version of the imported pack (null for fictional worlds).
  packVersion   String?
  /// Market value model fitted to the pack's real values (null = engine default model).
  valueModel    Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastPlayedAt  DateTime @default(now())

  nations      Nation[]
  competitions Competition[]
  stadiums     Stadium[]
  clubs        Club[]
  players      Player[]

  @@index([userId, lastPlayedAt])
}

// ---------------------------------------------------------------------------
// Game world. Every table is scoped to a save and keyed by (saveId, id), where id is the
// engine's integer id. Rows are written in bulk from the engine's WorldState; integrity
// between world tables is maintained by the engine (no cross-table FKs, which keeps bulk
// writes simple and fast). Deleting a save cascades to its whole world.
// ---------------------------------------------------------------------------

model Nation {
  saveId     String
  id         Int
  save       SaveGame @relation(fields: [saveId], references: [id], onDelete: Cascade)
  name       String
  adjective  String
  code       String
  flavour    String
  reputation Int
  playable   Boolean
  /// Name pool for regens (empty arrays = use the flavour).
  firstNames String[] @default([])
  lastNames  String[] @default([])

  @@id([saveId, id])
}

model Competition {
  saveId           String
  id               Int
  save             SaveGame @relation(fields: [saveId], references: [id], onDelete: Cascade)
  nationId         Int
  name             String
  shortName        String
  /// "league" | "cup"
  kind             String
  tier             Int?
  reputation       Int
  clubIds          Int[]
  promotionPlaces  Int
  relegationPlaces Int
  /// generated | imported | simulated
  origin           String   @default("generated")

  @@id([saveId, id])
}

model Stadium {
  saveId   String
  id       Int
  save     SaveGame @relation(fields: [saveId], references: [id], onDelete: Cascade)
  name     String
  city     String?
  capacity Int

  @@id([saveId, id])
}

model Club {
  saveId             String
  id                 Int
  save               SaveGame @relation(fields: [saveId], references: [id], onDelete: Cascade)
  name               String
  shortName          String
  code               String
  nationId           Int
  city               String?
  founded            Int?
  primaryColor       String
  secondaryColor     String
  reputation         Int
  stadiumId          Int
  leagueId           Int?
  balance            Float
  transferBudget     Float
  /// Weekly wage budget.
  wageBudget         Float
  trainingFacilities Int
  youthFacilities    Int
  /// generated | imported | custom
  origin             String   @default("generated")
  crestKey           String?
  /// Source key and per-field provenance for imported clubs.
  source             Json?

  @@id([saveId, id])
  @@index([saveId, leagueId])
}

model Player {
  saveId          String
  id              Int
  save            SaveGame  @relation(fields: [saveId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  nationId        Int
  birthDate       DateTime  @db.Date
  heightCm        Int
  weightKg        Int
  /// "left" | "right" | "either"
  foot            String
  weakFoot        Int
  /// 1-20 values in engine ATTRIBUTE_KEYS order.
  attributes      Int[]
  /// 1-20 values in engine HIDDEN_KEYS order.
  hidden          Int[]
  /// Familiarity 1-20 per engine POSITIONS slot.
  positions       Int[]
  primaryPosition Int
  ca              Int
  pa              Int
  traits          String[]
  clubId          Int?
  /// Contract (all null for free agents). Wage is weekly.
  wage            Float?
  contractStart   DateTime? @db.Date
  contractEnd     DateTime? @db.Date
  squadStatus     String?
  releaseClause   Float?
  value           Float
  retired         Boolean   @default(false)
  /// generated | imported | custom
  origin          String    @default("generated")
  shirtNumber     Int?
  /// Source key, source ratings and per-field/per-attribute provenance for imported players.
  source          Json?

  @@id([saveId, id])
  @@index([saveId, clubId])
  @@index([saveId, ca])
  @@index([saveId, value])
  @@index([saveId, primaryPosition])
  @@index([saveId, lastName])
}

// ---------------------------------------------------------------------------
// Real-world history shipped with imported data packs. Immutable per pack version and shared by
// every save created from that version (saves never modify it). In-game transfers will live in
// a separate per-save table, so historical and simulated data never mix.
// ---------------------------------------------------------------------------

model DataPackVersion {
  pack        String
  version     String
  label       String
  startDate   DateTime @db.Date
  summary     Json
  installedAt DateTime @default(now())

  @@id([pack, version])
}

model HistoricalTransfer {
  id             Int      @id @default(autoincrement())
  pack           String
  version        String
  /// Canonical player id within the pack (= Player.id in saves created from it).
  playerId       Int
  date           DateTime @db.Date
  season         String?
  fromClubId     Int?
  toClubId       Int?
  fromClubName   String?
  toClubName     String?
  /// null = fee not reported (never stored as 0).
  feeEur         Float?
  /// paid | zero_reported | unknown
  feeStatus      String
  marketValueEur Float?
  /// Source transfer type when stated (e.g. loan).
  type           String?
  source         String

  @@index([pack, version, playerId])
}

model HistoricalValuation {
  id       Int      @id @default(autoincrement())
  pack     String
  version  String
  playerId Int
  date     DateTime @db.Date
  valueEur Float
  source   String

  @@index([pack, version, playerId])
}
