# ---------------------------------------------------------------
# Ultimate Manager - environment configuration
# Copy to .env (npm run dev does this automatically on first run).
# ---------------------------------------------------------------

# Database mode:
#   embedded -> `npm run dev` starts a local PostgreSQL (no Docker needed), data in ./.data/postgres
#   external -> you run Postgres yourself (e.g. `docker compose up -d`) at DATABASE_URL
DB_MODE=embedded

# Same URL works for both modes (embedded PG and docker-compose both listen on 5433).
DATABASE_URL=postgresql://um:um@localhost:5433/ultimate_manager
# Integration tests use a separate database (created automatically).
DATABASE_URL_TEST=postgresql://um:um@localhost:5433/ultimate_manager_test

# API
API_PORT=4000
API_HOST=127.0.0.1
# REQUIRED in production: a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-only-change-me-please-0123456789abcdef
# Session lifetime in days
SESSION_TTL_DAYS=7
# Allowed browser origin for CORS (the Vite dev server proxies /api, so this is mostly for tooling)
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Web
WEB_PORT=5173
