{
  "name": "ultimate-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Ultimate Manager - Road to Glory: a Football Manager-style web game",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "db:start": "node scripts/db-start.mjs",
    "db:migrate": "npm run db:migrate --workspace @um/api",
    "db:migrate:dev": "npm run db:migrate:dev --workspace @um/api",
    "db:reset": "npm run db:reset --workspace @um/api",
    "prepare": "husky",
    "db:generate": "npm run db:generate --workspace @um/api",
    "data:inspect": "tsx packages/data-import/src/cli.ts inspect",
    "data:import": "tsx packages/data-import/src/cli.ts import",
    "sim:development": "tsx packages/data-import/src/sim-cli.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "dotenv": "^18.0.7",
    "embedded-postgres": "^18.3.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/engines": true,
    "@embedded-postgres/windows-x64": true,
    "@embedded-postgres/linux-x64": true,
    "@embedded-postgres/linux-arm64": true,
    "@embedded-postgres/darwin-x64": true,
    "@embedded-postgres/darwin-arm64": true,
    "esbuild": true
  }
}
